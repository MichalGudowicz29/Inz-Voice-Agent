conversational_model = ChatOpenAI(
    model="gpt-5-nano",
    temperature=0
)

router_model = ChatOpenAI(
    model="gpt-4o-mini",
    temperature=0
).with_structured_output(RouterOutput)


def conversation(messages):
    ct0 = time.time()

    stream = conversational_model.stream(messages)

    sentence_buffer = ""
    full_response = ""

    first_token = False
    first_audio = False

    for chunk in stream:

        if not chunk.content:
            continue

        if not first_token:
            print(f"TTFT: {time.time() - ct0:.3f}s")
            first_token = True

        sentence_buffer += chunk.content
        full_response += chunk.content

        if re.search(r"[.!?]\s*$", sentence_buffer):

            if not first_audio:
                print(f"Time to First Audio: {time.time() - ct0:.3f}s")
                first_audio = True

            speak(sentence_buffer.strip())
            sentence_buffer = ""

    
    llm_end = time.time()
    print(f"LLM finished: {llm_end - ct0:.3f}s")

    if sentence_buffer.strip():
        speak(sentence_buffer.strip())

    total = time.time() - ct0
    print(f"Conversation total: {total:.3f}s")

    return full_response



